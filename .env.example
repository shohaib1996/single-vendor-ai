# Copy to .env and fill in. DATABASE_URL and JWT_SECRET must be the exact
# same values as single-vendor-backend/.env — this service reads the same
# Postgres DB and verifies the same JWTs issued by that backend.

DATABASE_URL=postgresql+asyncpg://neondb_owner:xxxx@ep-red-wildflower-adpx50vb-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=

OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=["http://localhost:3000"]

# Pinecone — get a key at app.pinecone.io. PINECONE_INDEX_NAME must match
# an index you created there (1024 dimensions, cosine) — see
# app/rag/vectorstore.py.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=single-vendor-kb

NODE_API_BASE_URL=http://localhost:5000/api/v1
INTERNAL_INGEST_TOKEN=

# Chat cost protection (app/core/rate_limit.py) — defaults shown, only
# set these if you want to override them
# RATE_LIMIT_CUSTOMER_PER_MINUTE=10
# RATE_LIMIT_ADMIN_PER_MINUTE=10
