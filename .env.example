JWT_SECRET=

OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=["http://localhost:3000"]

NODE_API_BASE_URL=http://localhost:5000/api/v1
INTERNAL_INGEST_TOKEN=
